# Copy to .env for local runs. On the server these live in /etc/portfolio/portfolio.env.
# Local default is a SQLite file; the server uses its own MySQL database, `portfolio` (see deploy/setup-db.sh).
DATABASE_URL=sqlite:///./portfolio-local.db
# DATABASE_URL=mysql+pymysql://portfolio:PASSWORD@127.0.0.1:3306/portfolio?charset=utf8mb4
ADMIN_KEY=change-me-long-random-string
HASH_SALT=change-me-another-random-string
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
